# herdr configuration - https://herdr.dev/docs/configuration/
#
# Seeded ONCE to ~/.config/herdr/config.toml by modules/52-herdr.sh and never
# overwritten afterwards, so anything you change here stays changed.
#
# Every other tool in this repo gets a tracked config symlinked into $HOME plus
# a separate gitignored file for machine-local deviation (~/.zshrc.local,
# ~/.tmux.conf.user, lua/config/local.lua, ghostty-local.conf). herdr cannot
# work that way: config.toml has no include/import directive, so there is
# nowhere for a second file to be layered on top. A tracked symlink would
# therefore force every per-machine tweak to dirty the dotfiles checkout - and
# get clobbered on the next `git pull`. So the deployed copy is the local file,
# and this is only its starting point.
#
# Re-print the full set of defaults at any time with:
#   herdr --default-config
# Apply edits to an already-running server without restarting it:
#   herdr server reload-config

[keys]
# ctrl+b deliberately, which is also tmux's prefix on this machine
# (.tmux.conf.local leaves gpakosz's C-a swap commented out). Both
# multiplexers therefore answer to the same muscle memory, and you never have
# to remember which one you are attached to.
#
# The one case where that bites is nesting - a herdr client running inside a
# tmux pane, or the reverse, where the outer multiplexer eats the prefix first.
# Change this line if you actually do that; don't change it pre-emptively.
prefix = "ctrl+b"

# Deliberately no other [keys] entries. herdr's defaults and oh-my-tmux's
# bindings already agree on `-`, h/j/k/l, c, x, z, 1..9 and ?; the rest differ
# (split right is `v` not `_`, detach is `q` not `d`, tabs are p/n not C-h/C-l)
# and were left alone on purpose. Seeding a remap here would only reach a *new*
# machine - this file is copied once and never overwritten - so every existing
# box would keep its old keys and `prefix ?` would be wrong on all of them.
# Learn the seven differences instead; docs/herdr-shortcut.md is that list.

[experimental]
# With a non-ASCII input source active (zhTW here), the key *after* the prefix
# never reaches herdr, so `prefix v` is indistinguishable from a dead prefix.
# This switches the host input source to an ASCII layout only while prefix mode
# is open, then restores it.
#
# Reaching for Caps Lock instead is the trap: it sends `V`, and herdr binds
# prefix+shift+<key> to *different* actions (prefix+shift+n is new_workspace),
# so an uppercase key matches no binding at all and still does nothing.
#
# Two things worth knowing. The key belongs under [experimental], NOT [keys],
# where it parses fine and is silently ignored. And being experimental it may
# be renamed upstream - `herdr server reload-config` reports that in its
# `diagnostics` array, and the fallback is to switch input source by hand.
switch_ascii_input_source_in_prefix = true

[theme]
# Rewritten by modules/52-herdr.sh from --theme at seed time. herdr ships
# built-ins for tokyonight (as "tokyo-night") and kanagawa but not ayu-dark,
# which is left on this value rather than approximated. `herdr
# --default-config` lists the full set.
name = "tokyo-night"

[session]
# Reattach a coding agent to its conversation when the server comes back after
# a restart, rather than leaving a dead pane. This resumes the SAME agent in
# the SAME pane, which is why it is safe for a staged workflow where each stage
# must be its own fresh session - see docs/herdr-loop-eng-tutorial.md.
resume_agents_on_restore = true
