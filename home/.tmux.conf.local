# -- navigation ----------------------------------------------------------------

# if you're running tmux within iTerm2
#   - and tmux is 1.9 or 1.9a
#   - and iTerm2 is configured to let option key act as +Esc
#   - and iTerm2 is configured to send [1;9A -> [1;9D for option + arrow keys
# then uncomment the following line to make Meta + arrow keys mapping work
#set -ga terminal-overrides "*:kUP3=\e[1;9A,*:kDN3=\e[1;9B,*:kRIT3=\e[1;9C,*:kLFT3=\e[1;9D"


# -- windows & pane creation ---------------------------------------------------

# new window retains current path, possible values are:
#   - true
#   - false (default)
tmux_conf_new_window_retain_current_path=false

# new pane retains current path, possible values are:
#   - true (default)
#   - false
tmux_conf_new_pane_retain_current_path=true

# new pane tries to reconnect ssh sessions (experimental), possible values are:
#   - true
#   - false (default)
tmux_conf_new_pane_reconnect_ssh=false

# prompt for session name when creating a new session, possible values are:
#   - true
#   - false (default)
tmux_conf_new_session_prompt=false


# -- display -------------------------------------------------------------------

# RGB 24-bit colour support (tmux >= 2.2), possible values are:
#  - true
#  - false (default)
#
# On: every modern terminal (Ghostty, iTerm2, WezTerm, Windows Terminal) speaks
# truecolor, and without it tmux quantises to 256 colours - which is why a
# Neovim colorscheme looks washed out inside tmux but correct outside it.
tmux_conf_theme_24b_colour=true

# The setting above drives oh-my-tmux's own _apply_24b(), but that function runs
# as a backgrounded job during startup and reads tmux_conf_theme_24b_colour from
# an environment snapshot that is not reliably populated in time - verified by
# hand in the test container: the variable was confirmed set in tmux's global
# environment, yet terminal-overrides never gained the Tc entry on a fresh
# session, 5/5 tries, even after a 2s wait. So declare it here instead, where it
# is parsed synchronously as part of this file and races nothing.
#
# Declare it by *capability*, not by terminal name. The first version of this
# fix was `terminal-overrides ",*256col*:Tc"`, which only ever matches a terminal
# whose TERM contains "256col" - true of xterm-256color, false of xterm-ghostty
# and false of the bare "xterm" that `docker run -t` hardcodes. That is why the
# same tmux session rendered correctly in iTerm2 and in 8 colours in Ghostty:
# pixel-sampling the two captures, the status segment styled '#00afff' below
# came out as #00b2ff in one and as #2743c7 - the terminal's ANSI palette 4 - in
# the other. terminal-features (tmux >= 3.2, which is Ubuntu 22.04's version)
# takes a pattern too, but "*" here means every terminal, not every terminal
# someone remembered to name. The Tc line stays for tmux < 3.2, where
# terminal-features does not exist.
#
# ~/.zshrc separately upgrades a TERM that has no terminfo entry at all; without
# that, nothing downstream of Ghostty on a Linux box can look its terminal up.
set -as terminal-features ",*:RGB"
set -ag terminal-overrides ",*256col*:Tc"

# window style
tmux_conf_theme_window_fg='default'
tmux_conf_theme_window_bg='default'

# highlight focused pane (tmux >= 2.1), possible values are:
#   - true
#   - false (default)
tmux_conf_theme_highlight_focused_pane=false

# Every colour from here down is tokyonight-night, the same palette Neovim's
# colorscheme and both terminal emulators use, so the status bar stops being a
# differently-themed strip under the editor. The trailing comment on each line
# names the palette entry rather than the colour, because "light blue" was true
# of #00afff and is not true of its replacement - a stale colour name is how
# these drift. Reference values: bg #1a1b26, bg_dark #16161e, bg_highlight
# #292e42, fg #c0caf5, fg_dark #a9b1d6, gutter #3b4261, blue #7aa2f7,
# red #f7768e, yellow #e0af68.
#
# To use something else on one machine, override in ~/.tmux.conf.user (see the
# end of this file) rather than editing here - this file is a symlink into the
# dotfiles repo.

# focused pane colours:
tmux_conf_theme_focused_pane_fg='default'
tmux_conf_theme_focused_pane_bg='#292e42'               # bg_highlight

# pane border style, possible values are:
#   - thin (default)
#   - fat
tmux_conf_theme_pane_border_style=thin

# pane borders colours:
tmux_conf_theme_pane_border='#3b4261'                   # gutter
tmux_conf_theme_pane_active_border='#7aa2f7'            # blue

# pane indicator colours
tmux_conf_theme_pane_indicator='#7aa2f7'                # blue
tmux_conf_theme_pane_active_indicator='#7aa2f7'         # blue

# status line style
tmux_conf_theme_message_fg='#1a1b26'                    # bg
tmux_conf_theme_message_bg='#e0af68'                    # yellow
tmux_conf_theme_message_attr='bold'

# status line command style (<prefix> : Escape)
tmux_conf_theme_message_command_fg='#e0af68'            # yellow
tmux_conf_theme_message_command_bg='#1a1b26'            # bg
tmux_conf_theme_message_command_attr='bold'

# window modes style
tmux_conf_theme_mode_fg='#1a1b26'                       # bg
tmux_conf_theme_mode_bg='#e0af68'                       # yellow
tmux_conf_theme_mode_attr='bold'

# status line style
tmux_conf_theme_status_fg='#a9b1d6'                     # fg_dark
tmux_conf_theme_status_bg='#16161e'                     # bg_dark
tmux_conf_theme_status_attr='none'

# terminal title
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{username}
#     - #{username_ssh}
tmux_conf_theme_terminal_title='#h ❐ #S ● #I #W'

# window status style
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{username}
#     - #{username_ssh}
tmux_conf_theme_window_status_fg='#a9b1d6'              # fg_dark
tmux_conf_theme_window_status_bg='#16161e'              # bg_dark
tmux_conf_theme_window_status_attr='none'
tmux_conf_theme_window_status_format='#I #W'
#tmux_conf_theme_window_status_format='#{circled_window_index} #W'
#tmux_conf_theme_window_status_format='#I #W#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}'

# window current status style
#   - built-in variables are:
#     - #{circled_window_index}
#     - #{circled_session_name}
#     - #{hostname}
#     - #{hostname_ssh}
#     - #{username}
#     - #{username_ssh}
tmux_conf_theme_window_status_current_fg='#1a1b26'      # bg
tmux_conf_theme_window_status_current_bg='#7aa2f7'      # blue
tmux_conf_theme_window_status_current_attr='bold'
tmux_conf_theme_window_status_current_format='#I #W'
#tmux_conf_theme_window_status_current_format='#{circled_window_index} #W'
#tmux_conf_theme_window_status_current_format='#I #W#{?window_zoomed_flag,🔍,}'

# window activity status style
tmux_conf_theme_window_status_activity_fg='default'
tmux_conf_theme_window_status_activity_bg='default'
tmux_conf_theme_window_status_activity_attr='underscore'

# window bell status style
tmux_conf_theme_window_status_bell_fg='#e0af68'         # yellow
tmux_conf_theme_window_status_bell_bg='default'
tmux_conf_theme_window_status_bell_attr='blink,bold'

# window last status style
tmux_conf_theme_window_status_last_fg='#7aa2f7'         # blue
tmux_conf_theme_window_status_last_bg='default'
tmux_conf_theme_window_status_last_attr='none'

# status left/right sections separators
# tmux_conf_theme_left_separator_main=''
# tmux_conf_theme_left_separator_sub='|'
# tmux_conf_theme_right_separator_main=''
# tmux_conf_theme_right_separator_sub='|'
# These need two things, and both failure modes look like a broken font:
#   1. a powerline-patched font in the *terminal emulator* (the machine you sit
#      at, not the box you SSH into) - otherwise you get tofu boxes;
#   2. a UTF-8 locale in the shell that starts tmux - tmux renders every
#      multibyte character as '_' when LANG/LC_ALL is unset or POSIX, so the
#      separators come out as underscores. ~/.zshrc sets LANG for this reason.
tmux_conf_theme_left_separator_main='\uE0B0'
tmux_conf_theme_left_separator_sub='\uE0B1'
tmux_conf_theme_right_separator_main='\uE0B2'
tmux_conf_theme_right_separator_sub='\uE0B3'

# status left/right content:
#   - separate main sections with '|'
#   - separate subsections with ','
#   - built-in variables are:
#     - #{battery_bar}
#     - #{battery_hbar}
#     - #{battery_percentage}
#     - #{battery_status}
#     - #{battery_vbar}
#     - #{circled_session_name}
#     - #{hostname_ssh}
#     - #{hostname}
#     - #{loadavg}
#     - #{pairing}
#     - #{prefix}
#     - #{root}
#     - #{synchronized}
#     - #{uptime_y}
#     - #{uptime_d} (modulo 365 when #{uptime_y} is used)
#     - #{uptime_h}
#     - #{uptime_m}
#     - #{uptime_s}
#     - #{username}
#     - #{username_ssh}
#
# The layout, left to right:
#
#   [ ❐ session ]  1 window  2 window  3 window ...  [ prefix ][ time ][ user ]
#
# Session name on the left, the window list in the middle (drawn by tmux from
# tmux_conf_theme_window_status_format above), clock and current user on the
# right. The user segment is what tells a root shell from a normal one at a
# glance - #{username} is the name and #{root} appends a blinking '!'.
#
# Deliberately absent: uptime, battery, and a `#(curl wttr.in)` shell-out. The
# last one fires on every status refresh, so on a build machine behind a proxy
# it either hangs the redraw or paints an error into the status bar.
tmux_conf_theme_status_left=' ❐ #S '
tmux_conf_theme_status_right='#{prefix}#{pairing}#{synchronized} , %R , #{username}#{root} '

# status left style
tmux_conf_theme_status_left_fg='#1a1b26'                # bg
tmux_conf_theme_status_left_bg='#e0af68'                # yellow
tmux_conf_theme_status_left_attr='bold'

# status right style
tmux_conf_theme_status_right_fg='#a9b1d6,#c0caf5,#1a1b26' # fg_dark, fg, bg
tmux_conf_theme_status_right_bg='#16161e,#f7768e,#c0caf5' # bg_dark, red, fg
tmux_conf_theme_status_right_attr='none,none,bold'

# pairing indicator
tmux_conf_theme_pairing='👓 '          # U+1F453
tmux_conf_theme_pairing_fg='none'
tmux_conf_theme_pairing_bg='none'
tmux_conf_theme_pairing_attr='none'

# prefix indicator
tmux_conf_theme_prefix='⌨ '            # U+2328
tmux_conf_theme_prefix_fg='none'
tmux_conf_theme_prefix_bg='none'
tmux_conf_theme_prefix_attr='none'

# root indicator
tmux_conf_theme_root='!'
tmux_conf_theme_root_fg='none'
tmux_conf_theme_root_bg='none'
tmux_conf_theme_root_attr='bold,blink'

# synchronized indicator
tmux_conf_theme_synchronized='🔒'     # U+1F512
tmux_conf_theme_synchronized_fg='none'
tmux_conf_theme_synchronized_bg='none'
tmux_conf_theme_synchronized_attr='none'

# battery bar symbols
tmux_conf_battery_bar_symbol_full='◼'
tmux_conf_battery_bar_symbol_empty='◻'
#tmux_conf_battery_bar_symbol_full='♥'
#tmux_conf_battery_bar_symbol_empty='·'

# battery bar length (in number of symbols), possible values are:
#   - auto
#   - a number, e.g. 5
tmux_conf_battery_bar_length='auto'

# battery bar palette, possible values are:
#   - gradient (default)
#   - heat
#   - 'colour_full_fg,colour_empty_fg,colour_bg'
tmux_conf_battery_bar_palette='gradient'
#tmux_conf_battery_bar_palette='#d70000,#e4e4e4,#000000'   # red, white, black

# battery hbar palette, possible values are:
#   - gradient (default)
#   - heat
#   - 'colour_low,colour_half,colour_full'
tmux_conf_battery_hbar_palette='gradient'
#tmux_conf_battery_hbar_palette='#d70000,#ff5f00,#5fff00'  # red, orange, green

# battery vbar palette, possible values are:
#   - gradient (default)
#   - heat
#   - 'colour_low,colour_half,colour_full'
tmux_conf_battery_vbar_palette='gradient'
#tmux_conf_battery_vbar_palette='#d70000,#ff5f00,#5fff00'  # red, orange, green

# symbols used to indicate whether battery is charging or discharging
tmux_conf_battery_status_charging='↑'       # U+2191
tmux_conf_battery_status_discharging='↓'    # U+2193
# tmux_conf_battery_status_charging='⚡ '    # U+26A1
# tmux_conf_battery_status_charging='🔌 '    # U+1F50C
# tmux_conf_battery_status_discharging='🔋 ' # U+1F50B

# clock style (when you hit <prefix> + t)
# you may want to use %I:%M %p in place of %R in tmux_conf_theme_status_right
tmux_conf_theme_clock_colour='#00afff'  # light blue
tmux_conf_theme_clock_style='24'


# -- clipboard -----------------------------------------------------------------

# in copy mode, copying selection also copies to the OS clipboard
#   - true
#   - false (default)
# on macOS, this requires installing reattach-to-user-namespace, see README.md
# on Linux, this requires xsel or xclip
tmux_conf_copy_to_os_clipboard=false


# -- user customizations -------------------------------------------------------
# this is the place to override or undo settings

# increase history size
#set -g history-limit 10000

# start with mouse mode enabled
set -g mouse on

# force Vi mode
#   really you should export VISUAL or EDITOR environment variable, see manual
#set -g status-keys vi
setw -g mode-keys vi

# Keep the selection after a mouse drag instead of copying and exiting copy
# mode immediately. Without this, releasing the mouse jumps straight back to
# the prompt and you lose the selection before you can act on it.
unbind -T copy-mode-vi MouseDragEnd1Pane

# replace C-b by C-a instead of using both prefixes
# set -gu prefix2
# unbind C-a
# unbind C-b
# set -g prefix C-a
# bind C-a send-prefix

# move status line to top
#set -g status-position top

# -- clipboard and paste -------------------------------------------------------

# Let tmux write to the system clipboard via OSC 52, which is what makes copy
# work over SSH without an X11 forwarding setup.
set -g set-clipboard on

# Advertise bracketed paste to programs running inside tmux. Without these
# capabilities tmux strips the terminal's \e[200~ ... \e[201~ markers, so a
# multi-line paste arrives as a series of bare newlines. In a modal editor
# those become motions rather than text, and in strict TUI key parsers they
# collapse the paste onto one line.
set -ag terminal-overrides ",*:smBP=\\E[?2004h,*:rmBP=\\E[?2004l"

# -- plugins -------------------------------------------------------------------

# tmux-resurrect: save and restore sessions across reboots.
#   prefix + Ctrl-s   save
#   prefix + Ctrl-r   restore
if '[ -f ~/.tmux/plugins/tmux-resurrect/resurrect.tmux ]' \
   'run-shell ~/.tmux/plugins/tmux-resurrect/resurrect.tmux'

# -- machine-local overrides ---------------------------------------------------

# ~/.tmux.conf.user: absent by default, never committed, lives in $HOME rather
# than in the repo (this file is a symlink, so anything written beside it would
# land in version control). Same arrangement as ~/.zshrc.local, Ghostty's
# ghostty-local.conf and nvim's lua/config/local.lua.
#
# It holds tmux commands, not oh-my-tmux's tmux_conf_* variables: those are read
# by _apply_configuration() out of *this* file specifically, so a variable set
# anywhere else is simply not seen. To recolour a segment, set the option
# directly - `set -g status-style "fg=...,bg=..."`,
# `set -g window-status-current-style ...`.
#
# Loaded from a hook rather than sourced here, because sourcing here does not
# work. oh-my-tmux's .tmux.conf sources this file (its line 160) and only then
# runs _apply_configuration (line 161), which writes status-style,
# window-status-current-style and the rest from the tmux_conf_theme_* variables
# above. Anything this file sets directly is therefore overwritten a moment
# later. Measured, not reasoned about: with `source-file ~/.tmux.conf.user`
# at this point, a user file setting bg=#040506 lost to the theme's bg=#16161e
# on a fresh session in the test container.
#
# session-created and client-attached both fire after the config queue has
# drained, so the override lands last and wins - verified the same way. Both
# hooks, because a detached `new-session -d` never attaches a client and an
# `attach` to an existing server never creates a session. Re-sourcing on every
# attach is harmless; these are idempotent `set` commands.
set-hook -g session-created 'source-file -q ~/.tmux.conf.user'
set-hook -g client-attached 'source-file -q ~/.tmux.conf.user'
